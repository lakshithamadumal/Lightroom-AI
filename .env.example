# OrcaRouter AI Configuration
ORCA_API_KEY=your_actual_api_key_here
ORCA_API_URL=https://api.orcarouter.ai/v1/chat/completions
ORCA_MODEL=fusion-flash

# Folder Paths
INPUT_FOLDER=C:/Media_Incoming
PRESET_FOLDER=C:/Media_Presets
OUTPUT_FOLDER=C:/Media_Output

# Processing Options
ENABLE_AI_SMART_CROP=true
ENABLE_AUTO_BALANCING=true
TARGET_MAX_WIDTH=1920
